<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="620"
        x:Class="SC4ModdingSuite.Views.HexCompareDialog"
        Title="Hex Compare"
        Icon="avares://SC4ModdingSuite/Assets/sc4msicon.ico"
        Width="960" Height="620"
        MinWidth="640" MinHeight="360"
        WindowStartupLocation="CenterOwner">

    <!-- Port of Ilive Reader's DlgHexCmp: two side-by-side hex dumps (built entirely in
         code-behind - see HexCompareDialog.axaml.cs - since there's no viewmodel state to
         bind, only a one-time snapshot of two byte buffers), differing bytes highlighted,
         scrolling kept in sync between the two panes (OnUserVScroll there), and
         Previous/Next buttons to jump between diff runs. -->
    <Grid Margin="8" RowDefinitions="Auto,*">
        <WrapPanel Grid.Row="0" Margin="0,0,0,6">
            <TextBlock x:Name="DiffCountText" VerticalAlignment="Center" FontSize="11" Classes="status" Margin="0,0,12,4" />
            <Button Content="◀ PREV DIFF" Click="OnPreviousClick" Margin="0,0,6,4" />
            <Button Content="NEXT DIFF ▶" Click="OnNextClick" Margin="0,0,0,4" />
        </WrapPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,*">
            <Border Grid.Column="0" BorderThickness="1" Margin="0,0,3,0">
                <ScrollViewer x:Name="LeftScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              ScrollChanged="OnLeftScrollChanged">
                    <StackPanel x:Name="LeftPanel" />
                </ScrollViewer>
            </Border>
            <Border Grid.Column="1" BorderThickness="1" Margin="3,0,0,0">
                <ScrollViewer x:Name="RightScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              ScrollChanged="OnRightScrollChanged">
                    <StackPanel x:Name="RightPanel" />
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>

</Window>
