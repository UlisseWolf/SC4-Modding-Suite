<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SC4ModdingSuite.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="620"
        x:Class="SC4ModdingSuite.Views.TgiEditorDialog"
        x:DataType="vm:TgiEditorDialogViewModel"
        Title="TGI Editor"
        Icon="avares://SC4ModdingSuite/Assets/sc4msicon.ico"
        Width="640" Height="620"
        MinWidth="480" MinHeight="440"
        WindowStartupLocation="CenterOwner">

    <!-- Port of Ilive Reader's DlgTGIEditor: pick several entries, apply a masked hex
         pattern ('#' = keep existing digit) to Type/Group/Instance across all of them at
         once. When exactly one row is selected, the section below the mask/grid also lets
         you edit that entry's TGI directly (manual values, or randomize Group/Instance) -
         the same single-entry editor this app always had, now hosted here instead of
         permanently taking up space in the main workspace. -->
    <Grid Margin="10" RowDefinitions="Auto,*,Auto,Auto,Auto">
        <TextBlock Grid.Row="0" Text="Select one or more entries (Ctrl/Shift-click for several):"
                   FontWeight="Bold" FontSize="11" Margin="0,0,0,6" />

        <DataGrid Grid.Row="1" x:Name="EntryGrid" ItemsSource="{Binding Entries}"
                  AutoGenerateColumns="False" CanUserReorderColumns="False" IsReadOnly="True"
                  SelectionMode="Extended" GridLinesVisibility="All" FontSize="11"
                  SelectionChanged="OnSelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Type" Binding="{Binding TypeHex}" Width="120" />
                <DataGridTextColumn Header="Group" Binding="{Binding GroupHex}" Width="120" />
                <DataGridTextColumn Header="Instance" Binding="{Binding InstanceHex}" Width="120" />
                <DataGridTextColumn Header="Entry type" Binding="{Binding EntryType}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,*,Auto,*" Margin="0,10,0,10">
            <TextBlock Grid.Column="0" Text="Type mask:" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox Grid.Column="1" Text="{Binding TypeMask}" FontFamily="Consolas,Menlo,monospace" Margin="0,0,8,0" />
            <TextBlock Grid.Column="2" Text="Group mask:" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox Grid.Column="3" Text="{Binding GroupMask}" FontFamily="Consolas,Menlo,monospace" Margin="0,0,8,0" />
            <TextBlock Grid.Column="4" Text="Instance mask:" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox Grid.Column="5" Text="{Binding InstanceMask}" FontFamily="Consolas,Menlo,monospace" />
        </Grid>

        <StackPanel Grid.Row="3" Spacing="8">
            <Button Content="APPLY MASK TO SELECTED" Command="{Binding ApplyCommand}" FontWeight="Bold" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Classes="status" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Single-entry direct edit - only meaningful (and only shown) for exactly one
             selected row; for several rows, the mask above is the only applicable tool.
             Every binding below goes through Document.* explicitly rather than rebinding
             this section's own DataContext, matching the same safe, already-proven pattern
             LtextTranslationDialog.axaml uses for the same "host another ViewModel's
             fields inside this dialog" situation. -->
        <Border Grid.Row="4" BorderThickness="1" Padding="10" Margin="0,10,0,0"
                IsVisible="{Binding IsSingleEntrySelected}">
            <StackPanel Spacing="6">
                <TextBlock Text="EDIT SELECTED ENTRY — TYPE ID MANUAL ONLY — GROUP/INSTANCE MANUAL OR RANDOM"
                           FontWeight="Bold" FontSize="11" />

                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="TYPE ID:" VerticalAlignment="Center" Margin="0,4,8,4" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Document.NewTypeText}" Margin="0,4" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="(always manual)" Classes="status"
                               VerticalAlignment="Center" FontSize="11" Margin="8,4,0,4" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="GROUP ID:" VerticalAlignment="Center" Margin="0,4,8,4" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Document.NewGroupText}"
                             IsEnabled="{Binding !Document.RandomizeGroup}" Margin="0,4" />
                    <CheckBox Grid.Row="1" Grid.Column="2" Content="Random"
                              IsChecked="{Binding Document.RandomizeGroup}" Margin="8,4,0,4" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="INSTANCE ID:" VerticalAlignment="Center" Margin="0,4,8,4" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Document.NewInstanceText}"
                             IsEnabled="{Binding !Document.RandomizeInstance}" Margin="0,4" />
                    <CheckBox Grid.Row="2" Grid.Column="2" Content="Random"
                              IsChecked="{Binding Document.RandomizeInstance}" Margin="8,4,0,4" />
                </Grid>

                <WrapPanel>
                    <Button Content="APPLY TGI CHANGE" Command="{Binding Document.ApplyTgiCommand}" Margin="0,0,8,4" />
                    <Button Content="RANDOMIZE G AND I" Command="{Binding Document.RandomizeBothCommand}" Margin="0,0,8,4" />
                    <Button Content="DELETE ENTRY" Command="{Binding Document.RemoveSelectedCommand}" Classes="danger" Margin="0,0,0,4" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>

</Window>
