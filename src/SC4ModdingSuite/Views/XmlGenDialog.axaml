<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SC4ModdingSuite.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="620" d:DesignHeight="560"
        x:Class="SC4ModdingSuite.Views.XmlGenDialog"
        x:DataType="vm:XmlGenDialogViewModel"
        Title="XML Property Generator"
        Icon="avares://SC4ModdingSuite/Assets/sc4msicon.ico"
        Width="620" Height="560"
        MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner">

    <!-- Port of Ilive Reader's DlgXmlGen/DlgXmlGenName: pick an Exemplar of a given
         ExemplarType, generate an SC4PLUGINDESC XML descriptor from its properties, add it
         to the open package. -->
    <Grid Margin="10" RowDefinitions="Auto,Auto,*,Auto,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto" Margin="0,0,0,8">
            <TextBlock Grid.Column="0" Text="ExemplarType (hex):" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Grid.Column="1" Text="{Binding ExemplarTypeHex}" Width="60" FontFamily="Consolas,Menlo,monospace" Margin="0,0,6,0" />
            <Button Grid.Column="2" Content="REFRESH" Command="{Binding RefreshCommand}" />
        </Grid>

        <TextBlock Grid.Row="1" Text="Matching exemplars:" FontWeight="Bold" FontSize="11" Margin="0,0,0,4" />

        <DataGrid Grid.Row="2" ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}"
                  AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All" FontSize="11">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Group" Binding="{Binding GroupHex}" Width="120" />
                <DataGridTextColumn Header="Instance" Binding="{Binding InstanceHex}" Width="120" />
                <DataGridTextColumn Header="Entry type" Binding="{Binding EntryType}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" ColumnDefinitions="Auto,*" Margin="0,10,0,10">
            <TextBlock Grid.Column="0" Text="Model file name (PLUGIN File=):" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Grid.Column="1" Text="{Binding ModelFileName}" Watermark="leave blank to auto-name from its resource key" />
        </Grid>

        <StackPanel Grid.Row="4" Spacing="8">
            <Button Content="GENERATE" Command="{Binding GenerateCommand}" FontWeight="Bold" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Classes="status" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>

</Window>
