<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SC4ModdingSuite.ViewModels"
        xmlns:views="using:SC4ModdingSuite.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="620"
        x:Class="SC4ModdingSuite.Views.S3DUVEditorDialog"
        x:DataType="vm:MainWindowViewModel"
        Title="S3D UV Editor"
        Icon="avares://SC4ModdingSuite/Assets/sc4msicon.ico"
        Width="760" Height="620"
        MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterOwner">

    <!-- Ilive Reader's Tab3DMUV equivalent (reader/Tab3DMUV.cpp): the resolved texture as a
         background with the editing group's UV points/wireframe drawn over it - drag a
         point to move it, or type exact U/V below. Drag on empty space for a rubber-band
         multi-select (Ctrl adds to the selection); dragging any selected point then moves
         the whole group together, and arrow keys nudge the selection by ±0.002 - Ilive's
         m_aSelected batch-edit, see Views/S3DUVEditorControl.cs. Operates on the same "editing group"
         (S3DEditGroupIndex) as the Geometry Editor's Vertices/Indices/Primitives grids, and
         the same resolved texture (S3DTexture) the "Solid" 3D preview already uses - see
         MainWindowViewModel's "UV Editor" region and Views/S3DUVEditorControl.cs for the
         drawing/drag logic. Opened via "UV EDITOR..." next to the other S3D editors in
         MainWindow's third panel (S3D Editor mode only). -->
    <Grid Margin="10" RowDefinitions="Auto,*,Auto">

        <Border Grid.Row="0" BorderThickness="1" Padding="8,6" Margin="0,0,0,8">
            <WrapPanel>
                <TextBlock Text="Editing group:" VerticalAlignment="Center" Margin="0,0,4,4" />
                <NumericUpDown Value="{Binding S3DEditGroupIndex}" Minimum="0" Maximum="{Binding S3DEditGroupMaxIndex}"
                               FormatString="0" Width="100" Margin="0,0,16,4" />

                <Button Content="−" FontWeight="Bold" MinWidth="32" Padding="0" Command="{Binding S3DUVZoomOutCommand}" Margin="0,0,2,4" />
                <TextBlock Text="{Binding S3DUVZoom, StringFormat='{}{0:P0}'}" VerticalAlignment="Center" MinWidth="56" TextAlignment="Center" Margin="0,0,2,4" />
                <Button Content="+" FontWeight="Bold" MinWidth="32" Padding="0" Command="{Binding S3DUVZoomInCommand}" Margin="0,0,16,4" />

                <TextBlock Text="Selected point U:" VerticalAlignment="Center" Margin="0,0,4,4" IsEnabled="{Binding HasS3DUVSelection}" />
                <NumericUpDown Value="{Binding S3DUVSelectedU}" Increment="0.01" FormatString="0.####" Width="110" Margin="0,0,12,4"
                               IsEnabled="{Binding HasS3DUVSelection}" />
                <TextBlock Text="V:" VerticalAlignment="Center" Margin="0,0,4,4" IsEnabled="{Binding HasS3DUVSelection}" />
                <NumericUpDown Value="{Binding S3DUVSelectedV}" Increment="0.01" FormatString="0.####" Width="110" Margin="0,0,4,4"
                               IsEnabled="{Binding HasS3DUVSelection}" />
            </WrapPanel>
        </Border>

        <Border Grid.Row="1" BorderThickness="1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <views:S3DUVEditorControl VertexBlock="{Binding S3DUVVertexBlock}"
                                           IndexBlock="{Binding S3DUVIndexBlock}"
                                           Texture="{Binding S3DTexture}"
                                           Zoom="{Binding S3DUVZoom}"
                                           SelectedIndex="{Binding S3DUVSelectedIndex, Mode=TwoWay}"
                                           ChangedCommand="{Binding S3DUVPointChangedCommand}" />
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" BorderThickness="1" Margin="0,8,0,0" Padding="8,6">
            <Button Content="APPLY / SAVE MODEL" Command="{Binding ApplyS3DCommand}" FontWeight="Bold"
                    ToolTip.Tip="Write the current model (incl. every UV change above) back into the entry" />
        </Border>
    </Grid>

</Window>
