<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SC4ModdingSuite.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="260"
        x:Class="SC4ModdingSuite.Views.ChangeInstanceDialog"
        x:DataType="vm:ChangeInstanceDialogViewModel"
        Title="Change Instance"
        Icon="avares://SC4ModdingSuite/Assets/sc4msicon.ico"
        Width="420" Height="260"
        MinWidth="380" MinHeight="240"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <!-- Port of Ilive Reader's DlgChangeInstance, plus a duplicate-TGI conflict check the
         original never had. -->
    <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="{Binding CurrentTgiText, StringFormat='Current TGI: {0}'}"
                   FontFamily="Consolas,Menlo,monospace" FontSize="12" Margin="0,0,0,10" />

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,0,0,10">
            <TextBlock Grid.Column="0" Text="New Instance ID:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Column="1" Text="{Binding NewInstanceHex}" FontFamily="Consolas,Menlo,monospace" />
        </Grid>

        <CheckBox Grid.Row="2" Content="Allow duplicate TGI (not recommended)" IsChecked="{Binding AllowConflict}"
                   IsVisible="{Binding HasConflict}" Margin="0,0,0,10" />

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" FontSize="11" Classes="status"
                   TextWrapping="Wrap" Margin="0,0,0,10" />

        <Button Grid.Row="5" Content="APPLY" Command="{Binding ApplyCommand}" FontWeight="Bold" HorizontalAlignment="Left" />
    </Grid>

</Window>
