<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SC4ModdingSuite.ViewModels"
        xmlns:views="using:SC4ModdingSuite.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1500" d:DesignHeight="820"
        x:Class="SC4ModdingSuite.Views.MainWindow"
        x:DataType="vm:MainWindowShellViewModel"
        Title="SC4 Modding Suite"
        Icon="avares://SC4ModdingSuite/Assets/sc4msicon.ico"
        Width="1500" Height="820"
        MinWidth="1080" MinHeight="640">

    <!-- MDI shell: Navigator tree (Plugins/Documents, Ilive Reader's Workspace bar) on the
         left, one tab per open document on the right - each tab hosts a whole
         Views/DbpfWorkspaceView (the former single-window MainWindow content) bound to its
         own MainWindowViewModel, so several .dat files really are open side by side at
         once instead of one replacing another. Compare/Merge/Directory-sync are
         multi-file tools that don't belong to any one tab, so they live in this shell's
         own toolbar instead - opened as ordinary dialogs, same pattern as every other
         dialog in this app (Options, S3D editors, ...). -->
    <Grid RowDefinitions="Auto,*">

        <Border Grid.Row="0" BorderThickness="0,0,0,1">
            <WrapPanel Margin="6">
                <Button Content="{Binding LocalizationService.ToolbarNew}" Click="OnNewClick" Margin="0,0,6,0"
                        ToolTip.Tip="{Binding LocalizationService.ToolbarNewTooltip}" />
                <Button Content="{Binding LocalizationService.ToolbarOpen}" Click="OnOpenClick" Margin="0,0,6,0"
                        ToolTip.Tip="{Binding LocalizationService.ToolbarOpenTooltip}" />
                <Rectangle Width="1" Height="24" Margin="0,2,6,2" />
                <Button Content="{Binding LocalizationService.ShellCompare}" Click="OnCompareClick" Margin="0,0,6,0"
                        ToolTip.Tip="{Binding LocalizationService.ShellCompareTooltip}" />
                <Button Content="{Binding LocalizationService.ShellMerge}" Click="OnMergeClick" Margin="0,0,6,0"
                        ToolTip.Tip="{Binding LocalizationService.ShellMergeTooltip}" />
                <Button Content="{Binding LocalizationService.ShellDirectorySync}" Click="OnDirectorySyncClick"
                        IsEnabled="{Binding SelectedDocument.HasOpenFile}"
                        ToolTip.Tip="{Binding LocalizationService.ShellDirectorySyncTooltip}" />
                <Rectangle Width="1" Height="24" Margin="0,2,6,2" />
                <Button Content="{Binding LocalizationService.ToolbarSave}" Click="OnSaveClick"
                        IsEnabled="{Binding SelectedDocument.CanSaveInPlace}" Margin="0,0,6,0" />
                <Button Content="{Binding LocalizationService.ToolbarSaveAs}" Click="OnSaveAsClick"
                        IsEnabled="{Binding SelectedDocument.HasOpenFile}" Margin="0,0,6,0" />
                <Rectangle Width="1" Height="24" Margin="0,2,6,2" />
                <Button Content="{Binding LocalizationService.ToolbarExportEntry}" Click="OnExportSelectedClick"
                        IsEnabled="{Binding SelectedDocument.SelectedEntry, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="0,0,6,0" />
                <Button Content="{Binding LocalizationService.ToolbarImportEntry}" Click="OnImportIntoSelectedClick"
                        IsEnabled="{Binding SelectedDocument.SelectedEntry, Converter={x:Static ObjectConverters.IsNotNull}}" Margin="0,0,6,0" />
                <Button Content="{Binding LocalizationService.ToolbarExportAll}" Click="OnExportAllClick"
                        IsEnabled="{Binding SelectedDocument.HasOpenFile}" Margin="0,0,6,0" />
                <Rectangle Width="1" Height="24" Margin="0,2,6,2" />
                <Button Content="{Binding LocalizationService.ToolbarOptions}" Click="OnOpenOptionsClick" />
            </WrapPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="160" MaxWidth="600" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigator: Plugins / SC4 Install folders, double-click an entry to open it in a new tab.
                 Each folder's own children are only read from disk the first time it's expanded
                 (see ViewModels/NavigatorNodeViewModel.EnsureChildrenLoaded) - the TreeView.Styles
                 setter below is what wires a TreeViewItem's own expand/collapse state back to the
                 corresponding NavigatorNodeViewModel.IsExpanded that triggers that lazy load. -->
            <Border Grid.Column="0" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="{Binding LocalizationService.ShellNavigatorHeader}" FontWeight="Bold" FontSize="11" Classes="status" Margin="8,6" />
                    <TreeView Grid.Row="1" x:Name="NavigatorTree" ItemsSource="{Binding NavigatorRoots}"
                              DoubleTapped="OnNavigatorDoubleTapped"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <TreeView.Styles>
                            <Style Selector="TreeViewItem" x:DataType="vm:NavigatorNodeViewModel">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            </Style>
                        </TreeView.Styles>
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate x:DataType="vm:NavigatorNodeViewModel" ItemsSource="{Binding Children}">
                                <!-- Plugins folder/file names can be far longer than the panel is wide
                                     (mod authors' naming conventions) - trimmed with an ellipsis instead
                                     of letting them overflow into the tab area, with the full name
                                     available as a tooltip on hover. -->
                                <TextBlock Text="{Binding Name}" FontSize="12"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                           ToolTip.Tip="{Binding Name}" />
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" ResizeDirection="Columns"
                           HorizontalAlignment="Stretch" Background="{DynamicResource ThemeBorder}" />

            <!-- One tab per open document -->
            <TabControl Grid.Column="2" ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument}">
                <TabControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MainWindowViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding DocumentTitle}" VerticalAlignment="Center" FontSize="12" />
                            <Button Content="x" Padding="5,0" FontSize="10" Click="OnCloseTabClick" Tag="{Binding}"
                                    ToolTip.Tip="{Binding LocalizationService.ShellCloseTabTooltip}" />
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate x:DataType="vm:MainWindowViewModel">
                        <views:DbpfWorkspaceView />
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Grid>
    </Grid>

</Window>
