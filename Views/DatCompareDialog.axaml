<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SC4ModdingSuite.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="620"
        x:Class="SC4ModdingSuite.Views.DatCompareDialog"
        x:DataType="vm:DatCompareDialogViewModel"
        Title="Compare DATs"
        Icon="avares://SC4ModdingSuite/Assets/sc4msicon.ico"
        Width="980" Height="620"
        MinWidth="720" MinHeight="440"
        WindowStartupLocation="CenterOwner">

    <!-- Port of Ilive Reader's DlgCompare: pick two .dat files, match entries by TGI, and
         list whether each pair is identical, differs in size, or differs in content -
         same three checkboxes (FC_same/FC_size/FC_text) filtering the grid. Double-click
         (or VIEW DIFF) on a matched row opens HexCompareDialog for the byte-level diff
         (DlgCompare::OnGridDblClick / DlgHexCmp). -->
    <Grid Margin="10" RowDefinitions="Auto,Auto,Auto,*,Auto">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,4">
            <TextBlock Grid.Column="0" Text="File 1:" VerticalAlignment="Center" Width="60" />
            <TextBox Grid.Column="1" Text="{Binding FilePath1}" Margin="0,0,8,0" IsReadOnly="True" />
            <Button Grid.Column="2" Content="Browse..." Click="OnBrowseFile1Click" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
            <TextBlock Grid.Column="0" Text="File 2:" VerticalAlignment="Center" Width="60" />
            <TextBox Grid.Column="1" Text="{Binding FilePath2}" Margin="0,0,8,0" IsReadOnly="True" />
            <Button Grid.Column="2" Content="Browse..." Click="OnBrowseFile2Click" />
        </Grid>

        <WrapPanel Grid.Row="2" Margin="0,0,0,8">
            <Button Content="COMPARE" Command="{Binding CompareCommand}" FontWeight="Bold" Margin="0,0,12,4" />
            <CheckBox Content="Show identical" IsChecked="{Binding ShowSame}" Margin="0,0,10,4" />
            <CheckBox Content="Show size differs" IsChecked="{Binding ShowSizeDiffers}" Margin="0,0,10,4" />
            <CheckBox Content="Show content differs" IsChecked="{Binding ShowContentDiffers}" Margin="0,0,10,4" />
            <Button Content="VIEW DIFF" Click="OnViewDiffClick"
                    IsEnabled="{Binding SelectedRow.CanViewDiff}" Margin="0,0,0,4" />
        </WrapPanel>

        <DataGrid Grid.Row="3" x:Name="CompareGrid" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                  AutoGenerateColumns="False" CanUserReorderColumns="False" IsReadOnly="True"
                  SelectionMode="Single" GridLinesVisibility="All" FontSize="11"
                  DoubleTapped="OnViewDiffClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="File 1 TGI" Binding="{Binding LeftTgi}" Width="150" />
                <DataGridTextColumn Header="File 1 type" Binding="{Binding LeftType}" Width="*" />
                <DataGridTextColumn Header="File 1 size" Binding="{Binding LeftSize}" Width="90" />
                <DataGridTextColumn Header="Result" Binding="{Binding ResultLabel}" Width="110" />
                <DataGridTextColumn Header="File 2 type" Binding="{Binding RightType}" Width="*" />
                <DataGridTextColumn Header="File 2 size" Binding="{Binding RightSize}" Width="90" />
                <DataGridTextColumn Header="File 2 TGI" Binding="{Binding RightTgi}" Width="150" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" FontSize="11" Classes="status" Margin="0,8,0,0" TextWrapping="Wrap" />
    </Grid>

</Window>
